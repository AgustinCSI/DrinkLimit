          </div>

          <ion-button
            class="control-consumo" type="button" aria-label="Añadir una cerveza"
            [disabled]="!sesionActiva()" (click)="abrirSelectorCerveza()"
          >
            <img src="assets/images/cerveza-agregar.png" alt="" width="188" height="276" />
            <span class="simbolo" aria-hidden="true">+</span>
          </ion-button>
        </div>

        @if (ultimaCerveza()) {
          <p class="resumen">Última registrada: {{ ultimaCerveza() }}</p>
        }

        @if (sesionActiva()) {
          <ion-button class="boton-detener" type="button" (click)="detenerPorEmbriaguez()">
